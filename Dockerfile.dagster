FROM python:3.14-slim
WORKDIR /app
# CPU-only torch (default Linux wheel bundles ~4GB of CUDA libs, unused here)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
# Same package set as Dockerfile.api plus dagster (vnmarket is vendored; pandas-ta installed --no-deps, see Dockerfile.api)
RUN grep -viE "^(-e \.\./vnmarket|chainlit|streamlit|ragas|datasets|chromadb|pandas-ta|langchain-chroma|langchain-google-vertexai)" requirements.txt > req-docker.txt \
 && pip install --no-cache-dir -r req-docker.txt && rm req-docker.txt \
 && pip install --no-cache-dir numba llvmlite && pip install --no-cache-dir --pre --no-deps pandas-ta \
 && pip install --no-cache-dir httpx pandas certifi seaborn openpyxl psutil tenacity pytz importlib-metadata \
 && pip install --no-cache-dir "psycopg[binary]"
# BCTC PDFs are scans: core/parse.py force_ocr=True needs an OCR engine. Tesseract + Vietnamese data is the main one (good
# diacritics). RapidOCR is the second engine for statement pages whose numbers Tesseract misreads (it read 85/85 numbers
# of a 90 dpi VHM scan, Tesseract 75/85) but loses part of the diacritics. Once RapidOCR is installed pymupdf4llm picks it for
# every page, so core/parse.py names Tesseract explicitly for the main pass.
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
# rapidocr depends on the GUI build of OpenCV (needs libGL, absent from python:slim); the headless build replaces it
RUN pip install --no-cache-dir rapidocr \
 && pip install --no-cache-dir --force-reinstall --no-deps opencv-python-headless
# dagster-postgres storage connects through psycopg 3 (the app code uses psycopg2-binary)
COPY . .
ENV PYTHONPATH=/app/vendor DAGSTER_HOME=/opt/dagster/home
# env comes from compose env_file; a copied .env would be loaded by the dagster CLI over it (host DAGSTER_HOME, localhost hosts)
RUN rm -f .env && mkdir -p $DAGSTER_HOME && cp infra/dagster/dagster.yaml $DAGSTER_HOME/
EXPOSE 3000
CMD ["dagster-daemon", "run", "-f", "pipeline/assets.py", "-d", "/app"]
