FROM python:3.14-slim
WORKDIR /app
# CPU-only torch (default Linux wheel bundles ~4GB of CUDA libs, unused here)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
# vnstock is not on PyPI; UI/eval/pipeline-only packages are not needed by the API
RUN grep -viE "^(vnstock|chainlit|streamlit|dagster|ragas|datasets|chromadb|langchain-chroma|langchain-google-vertexai)" requirements.txt > req-docker.txt  && pip install --no-cache-dir -r req-docker.txt && rm req-docker.txt
COPY . .
EXPOSE 8031
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8031"]
