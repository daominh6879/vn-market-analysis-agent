# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=ragdb
# POSTGRES_HOST=127.0.0.1  # default
# POSTGRES_PORT=5432        # default

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── LLM provider ──────────────────────────────────────────────────────────────
# Options: "deepseek" | "anthropic" | "openai" | "ollama"
LLM_PROVIDER=deepseek

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_CLOUD_HOST=https://ollama.com  # optional cloud endpoint
# OLLAMA_CLOUD_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=                        # only needed for Ollama Cloud

# ── RAGAS eval ────────────────────────────────────────────────────────────────
# Which LLM provider RAGAS uses for faithfulness/relevance scoring
RAGAS_PROVIDER=deepseek

# ── Langfuse tracing ──────────────────────────────────────────────────────────
# Leave blank to disable tracing
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Data providers ────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

VNSTOCK_API_KEY=vnstock_...

FIREANT_BASE=https://restv2.fireant.vn
FIREANT_EMAIL=your@email.com
FIREANT_PASSWORD=yourpassword

# ── Dagster ───────────────────────────────────────────────────────────────────
# Absolute path to dagster home directory (stores run history, logs)
DAGSTER_HOME=C:\Users\YourName\dagster_home

# ── Chainlit UI ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAINLIT_AUTH_SECRET=change-me-generate-a-random-secret

# ── Synthesis mode ────────────────────────────────────────────────────────────
# Set true to forbid buy/sell/hold recommendations in agent responses
STRICT_NEUTRAL=false

# ── OpenTelemetry tracing (arize-phoenix) ──────────────────────────────────────
# Set to enable OTel spans. Start phoenix: python -m phoenix.server.main serve
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Memory layer (tini-agent port) ─────────────────────────────────────────────
# Set to 1 to run a small-model gate that skips memory retrieval for irrelevant turns
RETRIEVAL_GATE=0
# Run memory consolidation every N turns (extract facts + episode summary)
CONSOLIDATE_EVERY=6
